{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{**/*.php,includes/**,database/**,js/**,css/**,images/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:;"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(css|js|images|uploads|attached_assets)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin_router.php?__route_path__=$1"
    },
    {
      "src": "/delivery/(.*)",
      "dest": "/api/delivery_router.php?__route_path__=$1"
    },
    {
      "src": "/restaurant/(.*)",
      "dest": "/api/restaurant_router.php?__route_path__=$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/api/index.php?__route_path__=$1"
    }
  ]
}
