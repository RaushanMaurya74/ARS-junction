{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/(css|js|images|uploads|attached_assets)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin_router.php?__route_path__=$1"
    },
    {
      "source": "/delivery/(.*)",
      "destination": "/api/delivery_router.php?__route_path__=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.php?__route_path__=$1"
    }
  ]
}
