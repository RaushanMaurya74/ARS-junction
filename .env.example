# Rate Limiting Configuration Thresholds
# Auth limits (login, signup, password reset): per-IP and per-account limits with exponential backoff
RL_AUTH_IP_MAX=5
RL_AUTH_ACCOUNT_MAX=5
RL_AUTH_WINDOW=900
RL_AUTH_BACKOFF_BASE=5
RL_AUTH_BACKOFF_MAX=1800

# Public endpoints limit (sliding window per minute)
RL_PUBLIC_MAX=60
RL_PUBLIC_WINDOW=60

# Authenticated user actions limit (sliding window per minute)
RL_AUTHED_MAX=200
RL_AUTHED_WINDOW=60

