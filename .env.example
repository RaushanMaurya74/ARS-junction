# ARS Junction Database Settings for Supabase Connection
SUPABASE_DB_HOST=db.mdkakmxielqjldpwwtcu.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.mdkakmxielqjldpwwtcu
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
